#!/bin/sh
echo "🛡️  Running pre-commit checks..."

# 1. Environment template check
npm run validate:env || exit 1

# 2. Lockfile synchronization check
npm run validate:lockfile || exit 1

# 3. Large files check
npm run validate:large-files || exit 1

# 4. Staged files validation (Prettier, ESLint, Secretlint)
npx lint-staged || exit 1

echo "✅ Pre-commit validation passed."
