{
  "name": "temp-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "tsx scripts/test-smoke.ts",
    "generate-data": "GROQ_API_KEY=your_key tsx scripts/generate-training-data.ts",
    "prepare-finetune": "tsx scripts/prepare-finetune.ts",
    "validate-data": "tsx scripts/validate-data.ts",
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:types": "tsc --noEmit",
    "check:circular": "madge --circular --extensions ts,tsx,js,jsx app components lib --exclude \"node_modules\"",
    "check:duplicate": "jscpd app components lib",
    "check:deadcode": "knip --no-exit-code",
    "check:licenses": "node scripts/check-licenses.js",
    "check:secrets": "secretlint \"**/*\"",
    "validate:env": "node scripts/validate-env.js",
    "validate:lockfile": "node scripts/validate-lockfile.js",
    "validate:large-files": "node scripts/validate-large-files.js",
    "check:all": "npm run format:check && npm run lint && npm run check:types && npm run check:circular && npm run check:duplicate && npm run check:deadcode && npm run check:licenses"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@supabase/auth-helpers-nextjs": "^0.10.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.1",
    "lucide-react": "^1.17.0",
    "next": "^16.2.9",
    "next-intl": "^4.13.0",
    "openai": "^6.42.0",
    "react": "^18",
    "react-dom": "^18",
    "recharts": "^3.8.1",
    "resend": "^6.12.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.2",
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.9",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-security": "^4.0.1",
    "husky": "^9.1.7",
    "jscpd": "^5.0.11",
    "knip": "^6.17.1",
    "lint-staged": "^17.0.8",
    "madge": "^8.0.0",
    "postcss": "^8",
    "prettier": "^3.8.4",
    "secretlint": "^13.0.2",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
